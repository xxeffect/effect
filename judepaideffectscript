
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local ragdollsFolder = Workspace:WaitForChild("Ragdolls")

-- Asset ID
local newTexture = "http://www.roblox.com/asset/?id=242986251"

-- Part 1: Knife Texturing Loop
task.spawn(function()
    while task.wait() do
        local judepaid = workspace:FindFirstChild("judepaid")
        
        -- Lock in main knives
        if judepaid then
            if judepaid:FindFirstChild("KnifeHandle") and judepaid.KnifeHandle:FindFirstChild("Freeze") then
                judepaid.KnifeHandle.Freeze.Texture = newTexture
            end
            
            if judepaid:FindFirstChild("Knife") and judepaid.Knife:FindFirstChild("Handle") and judepaid.Knife.Handle:FindFirstChild("Freeze") then
                judepaid.Knife.Handle.Freeze.Texture = newTexture
            end
        end

        -- Lock in thrown knives
        if workspace:FindFirstChild("KnifeHost") then
            for _, knife in ipairs(workspace.KnifeHost:GetChildren()) do
                local freeze = knife:FindFirstChild("Freeze")
                if freeze then
                    freeze.Texture = newTexture
                end
            end
        end
    end
end)

-- Part 2: Ragdoll Dragon Fire Style
local function applyDragonFireStyle(model)
    pcall(function()
        task.wait(0.05) 
        if not model or not model:IsA("Model") then return end

        -- Total cleanup tracking loop: if the ragdoll leaves the workspace, destroy everything
        task.spawn(function()
            while model and model.Parent == ragdollsFolder do
                task.wait(0.5)
            end
            if model then
                model:Destroy()
            end
        end)

        -- Loop through absolutely every descendant to find individual physical body components
        for _, obj in pairs(model:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" and not obj:FindFirstAncestorOfClass("Accessory") then
                
                -- Applied 24, 24, 24 Corroded Metal
                obj.Color = Color3.fromRGB(24, 24, 24)
                obj.Transparency = 0
                obj.Material = Enum.Material.CorrodedMetal
                
                -- Clear duplicate custom emitters if they exist on this part
                local existing = obj:FindFirstChild("DragonFireEmitter")
                if existing then existing:Destroy() end
                
                -- Instantiating the unique ParticleEmitter on this specific physical part
                local emitter = Instance.new("ParticleEmitter")
                emitter.Name = "DragonFireEmitter"
                emitter.Texture = newTexture
                
                -- Squash Sequence: 0 0 0 1 0 0 
                emitter.Squash = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0, 0),
                    NumberSequenceKeypoint.new(1, 0, 0)
                })
                
                -- Transparency Sequence: 0 0 0 1 0 0 
                emitter.Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0, 0),
                    NumberSequenceKeypoint.new(1, 0, 0)
                })
                
                -- Scaled down Size Sequence to make particles much smaller
                emitter.Size = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0.2, 0),      -- Reduced from 0.5 to 0.2
                    NumberSequenceKeypoint.new(0.25, 0.4, 0),    -- Reduced from 1 to 0.4
                    NumberSequenceKeypoint.new(0.375, 0.15, 0),  -- Reduced from 0.375 to 0.15
                    NumberSequenceKeypoint.new(1, 0.15, 0)       -- Reduced from 0.375 to 0.15
                })
                
                emitter.Parent = obj
                
            elseif obj:IsA("Accessory") then
                for _, part in pairs(obj:GetDescendants()) do
                    if part:IsA("BasePart") or part:IsA("Decal") then
                        part.Transparency = 0
                    end
                end
                
                task.delay(0.3, function()
                    if obj and obj.Parent then
                        for _, part in pairs(obj:GetDescendants()) do
                            if part:IsA("BasePart") or part:IsA("Decal") then
                                local fade = TweenService:Create(part, TweenInfo.new(2, Enum.EasingStyle.Linear), {Transparency = 1})
                                fade:Play()
                                fade.Completed:Connect(function() 
                                    if obj then obj:Destroy() end 
                                end)
                            end
                        end
                    end
                end)
            end
        end
    end)
end

-- Listener & Initial Sweep
ragdollsFolder.ChildAdded:Connect(function(child)
    if child.Name == "" then applyDragonFireStyle(child) end
end)

for _, child in ipairs(ragdollsFolder:GetChildren()) do
    if child.Name == "" then applyDragonFireStyle(child) end
end

print("Dragon Fire Override & Knife Sync: Both scripts active.")
