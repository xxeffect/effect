-- Final safety pass: make everything unclickable except the Close Triggers
local function makeEntireGuiUnclickable(root)
	for _, obj in ipairs(root:GetDescendants()) do
		if obj.Name == "ZapRagdollButton" or obj.Name == "DragonFireRagdollButton" then
			obj.Active = true
			obj.Selectable = true
			continue -- Skip locking out our interactive buttons
		end
		
		if obj:IsA("GuiObject") then
			obj.Active = false
			obj.Selectable = false
		end

		if obj:IsA("GuiButton") then
			obj.AutoButtonColor = false
		end
	end
end

