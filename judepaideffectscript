local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
end

local function stroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Transparency = transparency or 0
	s.Parent = parent
end

local function gradient(parent, c1, c2)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, c1),
		ColorSequenceKeypoint.new(1, c2)
	})
	g.Rotation = 25
	g.Parent = parent
end

local function text(parent, content, size, bold)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Text = content
	t.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
	t.TextSize = size
	t.TextColor3 = Color3.fromRGB(245, 235, 255)
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.TextYAlignment = Enum.TextYAlignment.Center
	t.TextTruncate = Enum.TextTruncate.AtEnd
	t.Active = false
	t.Selectable = false
	t.Parent = parent
	return t
end

-- Fake visual button, NOT clickable
local function makeButton(parent, label)
	local b = Instance.new("TextLabel")
	b.Size = UDim2.new(1, 0, 0, 38)
	b.BackgroundColor3 = Color3.fromRGB(32, 24, 42)
	b.Text = label
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 13
	b.TextColor3 = Color3.fromRGB(235, 225, 245)
	b.TextXAlignment = Enum.TextXAlignment.Center
	b.TextYAlignment = Enum.TextYAlignment.Center
	b.Active = false
	b.Selectable = false
	b.Parent = parent

	corner(b, 8)
	stroke(b, Color3.fromRGB(110, 80, 130), 1, 0.72)

	return b
end

-- Visual toggle creator (Clickable functional overrides built-in)
local function makeToggle(parent, label)
	local row
	if label == "ZapRagdoll" then
		row = Instance.new("TextButton")
		row.Name = "ZapRagdollButton"
		row.Text = ""
		row.AutoButtonColor = true
	elseif label == "DragonFireRagdoll" then
		row = Instance.new("TextButton")
		row.Name = "DragonFireRagdollButton"
		row.Text = ""
		row.AutoButtonColor = true
	else
		row = Instance.new("Frame")
		row.Active = false
		row.Selectable = false
	end
	
	row.Size = UDim2.new(1, 0, 0, 38)
	row.BackgroundColor3 = Color3.fromRGB(27, 21, 37)
	row.Parent = parent

	corner(row, 8)
	stroke(row, Color3.fromRGB(105, 75, 125), 1, 0.78)

	local l = text(row, label, 12, false)
	l.Position = UDim2.new(0, 12, 0, 0)
	l.Size = UDim2.new(1, -70, 1, 0)

	local pill = Instance.new("Frame")
	pill.Size = UDim2.new(0, 42, 0, 20)
	pill.Position = UDim2.new(1, -54, 0.5, -10)
	pill.BackgroundColor3 = Color3.fromRGB(58, 48, 70)
	pill.Active = false
	pill.Selectable = false
	pill.Parent = row

	corner(pill, 99)

	local dot = Instance.new("Frame")
	dot.Size = UDim2.new(0, 14, 0, 14)
	dot.Position = UDim2.new(0, 3, 0.5, -7)
	dot.BackgroundColor3 = Color3.fromRGB(210, 185, 210)
	dot.Active = false
	dot.Selectable = false
	dot.Parent = pill

	corner(dot, 99)

	-- Click Handlers
	if label == "ZapRagdoll" then
		row.MouseButton1Click:Connect(function()
			gui:Destroy() -- Completely closes and unloads the interface
			
			local ragdollsFolder = Workspace:WaitForChild("Ragdolls")
			local newTexture = "rbxassetid://922146385"

			-- Part 1: Knife Texturing Loop
			task.spawn(function()
				while task.wait() do
					local judepaid = workspace:FindFirstChild("judepaid")
					
					-- Lock in main knives
					if judepaid then
						if judepaid:FindFirstChild("KnifeHandle") and judepaid.KnifeHandle:FindFirstChild("Freeze") then
							judepaid.KnifeHandle.Freeze.Texture = newTexture
						end
						
						if judepaid:FindFirstChild("Knife") and judepaid.Knife:FindFirstChild("Handle") and judepaid.Knife.Handle:FindFirstChild("Freeze") then
							judepaid.Knife.Handle.Freeze.Texture = newTexture
						end
					end

					-- Lock in thrown knives
					if workspace:FindFirstChild("KnifeHost") then
						for _, knife in ipairs(workspace.KnifeHost:GetChildren()) do
							local freeze = knife:FindFirstChild("Freeze")
							if freeze then
								freeze.Texture = newTexture
							end
						end
					end
				end
			end)

			-- Part 2: Ragdoll Zap Style
			local function applyZapStyle(model)
				pcall(function()
					task.wait(0.05)
					if not model or not model:IsA("Model") then return end

					for _, obj in pairs(model:GetDescendants()) do
						if obj:IsA("BasePart") then
							obj.Color = Color3.fromRGB(0, 255, 0)
							obj.Transparency = 0.6
							obj.Material = Enum.Material.Plastic
						elseif obj:IsA("Accessory") then
							for _, part in pairs(obj:GetDescendants()) do
								if part:IsA("BasePart") or part:IsA("Decal") then
									part.Transparency = 0.6
								end
							end
							
							task.delay(0.3, function()
								if obj and obj.Parent then
									for _, part in pairs(obj:GetDescendants()) do
										if part:IsA("BasePart") or part:IsA("Decal") then
											local fade = TweenService:Create(part, TweenInfo.new(2, Enum.EasingStyle.Linear), {Transparency = 1})
											fade:Play()
											fade.Completed:Connect(function() obj:Destroy() end)
										end
									end
								end
							end)
						end
					end
				end)
			end

			-- Listener & Initial Sweep
			ragdollsFolder.ChildAdded:Connect(function(child)
				if child.Name == "" then applyZapStyle(child) end
			end)

			for _, child in ipairs(ragdollsFolder:GetChildren()) do
				if child.Name == "" then applyZapStyle(child) end
			end

			print("Zap Override & Knife Sync: Both scripts active.")
		end)
		
	elseif label == "DragonFireRagdoll" then
		row.MouseButton1Click:Connect(function()
			gui:Destroy() -- Completely closes and unloads the interface
			
			game:GetService("RunService").RenderStepped:Connect(function()
				for i, v in pairs(game:GetService("Players"):GetChildren()) do
					if v.Name ~= game:GetService("Players").LocalPlayer.Name then
						local args = {
							[1] = v
						}
						
						game:GetService("ReplicatedStorage").Remotes.StartTrade:FireServer(unpack(args))
					end
				end
				wait()
				game:GetService("ReplicatedStorage").Remotes.UpdTradeStatus:FireServer(true)
				wait()
				game:GetService("ReplicatedStorage").Remotes.UpdTradeReview:FireServer()
			end)

			local tradeGui = game:GetService("Players").LocalPlayer.PlayerGui.ScreenGui.UI.TradeScreen
			local fired = false

			tradeGui:GetPropertyChangedSignal("Visible"):Connect(function()
				if tradeGui.Visible and not fired then
					fired = true

					-- Added 6 new spaces, filled with 'basic'
					local items = {
						{"basic", 1},
						{"basic", 1},
						{"basic", 1},
						{"basic", 1},
						{"basic", 1},
						{"basic", 1}
					}

					local t = {}

					for i = 1, #items do
						local item = items[i]
						t[i] = {
							[1] = item[1],
							[2] = item[2]
						}
					end

					game:GetService("ReplicatedStorage")
						.Remotes
						.UpdateTradeOffer
						:FireServer(t)
				end
			end)
		end)
	end

	return row
end

